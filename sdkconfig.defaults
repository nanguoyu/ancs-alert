# ANCS 消息提醒器 —— ESP32-C3,8 MB Flash,无 PSRAM。ESP-IDF 5.5.3。

# --- 芯片与 Flash ---
CONFIG_IDF_TARGET="esp32c3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=n
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# --- 控制台走芯片自带 USB(UART0 的 TX 脚是屏幕背光)---
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# --- 系统 ---
CONFIG_FREERTOS_HZ=1000
# C3 的 IRAM 与堆共用同一块 SRAM:不追求中断里调用的函数放进 Flash,省下的都给堆
# (Wi-Fi 与 TLS 要用)。这些函数都不会在 Flash 关闭缓存期间被调用。
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_HEAP_PLACE_FUNCTION_INTO_FLASH=y
CONFIG_RINGBUF_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_LOG_IN_IRAM=n

# --- LVGL ---
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_DEF_REFR_PERIOD=20
# LVGL 自己的内存池(静态分配)。LVGL 9.5 只认按字节的 LV_MEM_SIZE,默认 64 KB 太多。
# 实测开机建好各页约用 19 KB,配网页的二维码再加约 5 KB;留出余量。用量见开机日志 “LVGL 内存”。
CONFIG_LV_MEM_SIZE=32768
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
# 未读数与配对码的大字号。
CONFIG_LV_FONT_MONTSERRAT_48=y
# 24 px 中文字库(GB2312 全部汉字)的位图超过 1 MB,需要大字库格式。
CONFIG_LV_FONT_FMT_TXT_LARGE=y
# 配网页的 Wi-Fi 二维码。
CONFIG_LV_USE_QRCODE=y

# --- 蓝牙 LE / NimBLE ---
# 本机是可连接的外设,同时作为 iPhone ANCS 的 GATT 客户端;
# NimBLE 的 GATT client 依赖 CENTRAL 角色开关(不会主动扫描或连接别的设备)。
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_GATT_CLIENT=y
# 最多同时连接 3 台 iPhone(与 wx_ble.h 的 WX_BLE_MAX_PHONES 一致),配对记录也最多 3 台。
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=3
CONFIG_BT_NIMBLE_MAX_BONDS=3
# 每台手机同时可能有服务发现、读型号、写 Control Point 等 GATT 操作。
CONFIG_BT_NIMBLE_GATT_MAX_PROCS=8
CONFIG_BT_NIMBLE_HOST_BASED_PRIVACY=n
# 配对密钥存 NVS,重启后不用重新配对。
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_SMP_ID_RESET=n

# --- Wi-Fi(只在保存了网络或配网时启动)---
# 没有 PSRAM,蓝牙、Wi-Fi 和 TLS 同时工作时内存紧:收发缓冲按够用配置,关掉聚合帧,
# 驱动与协议栈的热路径不放 IRAM(C3 的 IRAM 和 DRAM 共用同一块 SRAM)。
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_LWIP_IRAM_OPTIMIZATION=n
# 网页服务(4 个连接 + 内部 3 个)、DNS 与 HTTPS 同时要用套接字。
CONFIG_LWIP_MAX_SOCKETS=12
# 配网热点的 DHCP 把板子自己作为 DNS 发给手机,配合 wx_portal 的 DNS 弹出设置网页。
CONFIG_LWIP_DHCPS_ADD_DNS=y

# --- TLS(Telegram Bot API 走 HTTPS)---
# 缓冲按需分配、握手后释放;服务器发来的记录最大 16 KB,接收缓冲不能更小。
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CA_CERT=y
CONFIG_MBEDTLS_ASYMMETRIC_CONTENT_LEN=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096

# --- 设置网页 ---
# iPhone 的联网检测请求头较长,默认 512 字节不够。
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
